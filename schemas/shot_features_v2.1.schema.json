{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shot Features V2.1 Schema",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\.1$" },

    "video": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2, "maxItems": 2
        },
        "total_frames": { "type": "integer", "minimum": 1 }
      },
      "required": ["path", "fps", "size", "total_frames"],
      "additionalProperties": true
    },

    "generation": {
      "type": "object",
      "properties": {
        "created_utc": { "type": "string", "format": "date-time" },
        "commit": { "type": "string" },
        "branch": { "type": "string" },
        "params_hash": { "type": "string" },
        "detector": { "type": "object" },
        "embedder": { "type": "object" },
        "tracking": { "type": "object" },
        "validator": { "type": "object" },
        "emb_store": { "type": "string", "enum": ["inline", "sidecar", "none"] }
      },
      "required": ["created_utc", "commit", "branch", "params_hash"],
      "additionalProperties": true
    },

    "face_metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "face_label": { "type": "string" },
          "speaker_label": { "type": "string" },
          "occurance_count": { "type": "integer", "minimum": 0 }
        },
        "anyOf": [
          { "required": ["face_label", "occurance_count"] },
          { "required": ["speaker_label", "occurance_count"] }
        ],
        "additionalProperties": false
      }
    },

    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shot_number": { "type": "integer", "minimum": 1 },
          "first_frame": { "type": "integer", "minimum": 0 },
          "last_frame":  { "type": "integer", "minimum": 0 },
          "num_tracks":  { "type": "integer", "minimum": 0 },

          "face_tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "first_frame":   { "type": "integer", "minimum": 0 },
                "last_frame":    { "type": "integer", "minimum": 0 },
                "face_label":    { "type": "string" },
                "avg_center_x":  { "type": "number", "minimum": 0, "maximum": 100 },
                "avg_center_y":  { "type": "number", "minimum": 0, "maximum": 100 },
                "avg_face_width":  { "type": "number", "minimum": 0, "maximum": 100 },
                "avg_face_height": { "type": "number", "minimum": 0, "maximum": 100 },
                "is_static":     { "type": "boolean" },

                "obs_offset":    { "type": "integer", "minimum": 0 },
                "obs_count":     { "type": "integer", "minimum": 0 }
              },
              "required": [
                "first_frame","last_frame","face_label",
                "avg_center_x","avg_center_y","avg_face_width","avg_face_height",
                "is_static",
                "obs_offset","obs_count"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["shot_number","first_frame","last_frame","num_tracks","face_tracks"],
        "additionalProperties": false
      }
    },

    "observations_sidecar": {
        "type": "object",
        "properties": {
            "path":   { "type": "string", "minLength": 1 },
            "format": { "type": "string", "enum": ["npz"] },
            "dtype":  { "type": "string", "enum": ["structured"] },
            "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "desc": { "type": "string" }
                },
                "required": ["name","type"],
                "additionalProperties": false
            }
            },
            "count":  { "type": "integer", "minimum": 0 }
        },
        "required": ["path","format","dtype","fields","count"],
        "additionalProperties": false
        },

    "embedding_sidecar": {
      "type": "object",
      "properties": {
        "path":   { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["npz", "npy"] },
        "dtype":  { "type": "string", "enum": ["float32"] },
        "dim":    { "type": "integer", "minimum": 0 },
        "count":  { "type": "integer", "minimum": 0 }
      },
      "required": ["path","format","dtype","dim","count"],
      "additionalProperties": false
    },

    "totals": {
      "type": "object",
      "properties": {
        "num_shots":  { "type": "integer", "minimum": 0 },
        "num_tracks": { "type": "integer", "minimum": 0 }
      },
      "required": ["num_shots","num_tracks"],
      "additionalProperties": false
    }
  },

  "required": ["schema_version","video","generation","shots","observations_sidecar"],
  "additionalProperties": false
}
